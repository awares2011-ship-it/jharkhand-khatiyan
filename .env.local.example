# Copy this file to .env.local and fill in a real value if you have one.
# `pnpm dev` already works without it (mandi rates fall back to data.gov.in's
# shared public demo key, then to bundled sample data).

# Live mandi rates — data.gov.in (Agmarknet). Free key: https://data.gov.in/user/register
# Without this the app uses data.gov.in's shared public demo key, which is
# rate-limited and may throttle under real traffic.
DATA_GOV_IN_API_KEY=

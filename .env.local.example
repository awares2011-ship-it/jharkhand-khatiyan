# Copy this file to .env.local and fill in real values.
# `npm run dev` already works without any of these (every feature has a
# built-in fallback), but set them for reliable live data + real push delivery.

# Live mandi rates — data.gov.in (Agmarknet). Free key: https://data.gov.in/user/register
# Without this the app uses data.gov.in's shared public demo key, which is
# rate-limited and may throttle under real traffic.
DATA_GOV_IN_API_KEY=

# Web Push (background "every 3 hours" notifications). Generate a real pair
# with: npm run vapid  — then paste both values below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret required by /api/cron/refresh and /api/cron/notify so random
# visitors can't trigger them. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
